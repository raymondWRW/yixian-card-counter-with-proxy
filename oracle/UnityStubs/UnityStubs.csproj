<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CS0626;CS0067;CS0649;CS0169;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <!-- Exclude facade source files — they're compiled individually by build-facades.sh -->
  <ItemGroup>
    <Compile Remove="facades\**" />
  </ItemGroup>

</Project>
