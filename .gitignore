# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# ─── Node ─────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── PyInstaller / build artifacts ────────────────────────────────────────────
build/
dist/
*.spec

# Built binaries — distribute via GitHub Releases, not the repo (30 MB each).
small_card_counter/YiXianCounterLite.exe
small_card_counter/dist_share/YiXianCounterLite.exe

# Hand-zipped share bundles (also 30+ MB).
small_card_counter/*.zip
small_card_counter/dist_share/*.zip

# ─── Captured game data (PERSONAL — contains your UID + traffic) ──────────────
# Anything written by the proxy at runtime is private to the user who ran it.
proxy/output/

# Entire analysis folder — local debugging scripts + their captured outputs.
proxy_analysis/

# Local game log copy if it ever lands here
BattleLog.json

# ─── Runtime/state ────────────────────────────────────────────────────────────
# Settings written by the app at runtime
settings.json

# ─── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS junk ──────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ─── Claude / agent state ─────────────────────────────────────────────────────
# Local Claude session data (memories, plans, transcripts) — not for sharing.
.claude/

# ─── Misc temp ────────────────────────────────────────────────────────────────
*.tmp
*.bak
*.orig
