# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# ─── Node ─────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── PyInstaller / build artifacts ────────────────────────────────────────────
build/
dist/
*.spec

# Built binaries — distribute via GitHub Releases, not the repo (30 MB each).
small_card_counter/YiXianCounterLite.exe
small_card_counter/dist_share/YiXianCounterLite.exe

# Hand-zipped share bundles (also 30+ MB).
small_card_counter/*.zip
small_card_counter/dist_share/*.zip

# ─── Captured game data (PERSONAL — contains your UID + traffic) ──────────────
# Anything written by the proxy at runtime is private to the user who ran it.
proxy/output/

# Per-game battle log captures (YX_DEBUG=1 / capture_game.bat output).
# Contains msgdump.jsonl, shadow_log.txt, deck_tracker.jsonl, battle_log.json —
# all riddled with UIDs, usernames, opponent names, and hand contents.
battle_log/

# Entire analysis folder — local debugging scripts + their captured outputs.
proxy_analysis/

# Account UID is persisted here by the proxy (addon.py _set_me_uid).
# Personal — must NOT be tracked. (Currently committed; untrack with
#   git rm --cached proxy/config.json small_card_counter/proxy/config.json)
proxy/config.json
small_card_counter/proxy/config.json

# Verification reports reference real usernames + per-round game data from
# captures; private to the user who ran verify_damage.py.
tools/verify_*.md
tools/verify_*.json

# Lite version's diagnostic log (written to dist_share when running).
yxlite-log.txt
small_card_counter/dist_share/yxlite-log.txt

# Local game log copy if it ever lands here
BattleLog.json

# ─── Runtime/state ────────────────────────────────────────────────────────────
# Settings written by the app at runtime
settings.json

# ─── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS junk ──────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ─── Claude / agent state ─────────────────────────────────────────────────────
# Local Claude session data (memories, plans, transcripts) — not for sharing.
.claude/

# ─── Misc temp ────────────────────────────────────────────────────────────────
*.tmp
*.bak
*.orig

# ── Yi Xian Oracle ─────────────────────────────────────────────────────────
# Engine SOURCE under oracle/ IS committed. The rest is heavy/derived/game-owned.
# (gitignore has no inline comments — keep patterns on their own lines.)
# extracted game DLL + config .dat (game-owned, ~12MB):
oracle/data/
# DummyDll dump (derived from the game):
oracle/tools/Il2CppDumper/
# build output + facade DLLs (regenerable):
oracle/**/bin/
oracle/**/obj/
oracle/UnityStubs/bin/
oracle/UnityStubs/obj/
# third-party Cecil DLLs (binary):
oracle/ILRuntime/

# Built exe is 100MB+ (node bundled) — distributed via Gitee releases, not git.
/YiXianCounter.exe
/dist_share/YiXianCounter.exe

# Oracle publish staging (build artifact)
/_oracle_pub/

# Hand-zipped share bundles (100MB+) and Oracle runtime markers (per-machine).
/dist_share.zip
dist_share/*.zip
oracle/.oracle_version
oracle/UnityStubs/bin/facades-gen/.gakey

# Oracle engine bundle (downloaded on first run; distributed via Gitee, not git).
dist_share/oracle-engine-*.zip
# engine.json is build-generated (url+sha for the engine download).
oracle/engine.json
